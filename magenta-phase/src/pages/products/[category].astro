---
import StoreLayout from '../../layouts/StoreLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { PRODUCTS, SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '../../consts.ts';

export const getStaticPaths = (): ASTRO.PathConfig[] =>
	CATEGORIES.map((category) => ({
		params: { category },
		props: { category },
	}));

interface Props {
	category: string;
}

const { category } = Astro.props;
const categoryProducts = PRODUCTS.filter((product) => product.category === category);
---

<StoreLayout title={`${category} — ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<header class="page-head">
		<p class="page-head__eyebrow">Shop by category</p>
		<h1>{category}</h1>
		<p class="page-head__subtitle">
			{categoryProducts.length} curated pieces in {category}.
		</p>
	</header>

	<section class="shop-toolbar">
		<div class="filter-chips">
			{CATEGORIES.map((cat) => (
				<a
					href={`/products/${cat}`}
					class:list={[cat === category ? 'chip chip--active' : 'chip']}
				>
					{cat}
				</a>
			))}
		</div>
	</section>

	{categoryProducts.length > 0 ? (
		<section class="product-grid">
			{categoryProducts.map((product) => (
				<ProductCard product={product} />
			))}
		</section>
	) : (
		<div class="empty-state">
			No pieces in this category yet. Check back soon for new arrivals.
		</div>
	)}
</StoreLayout>
